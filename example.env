# Refer to Airflow documentation for setting UID's and running Airflow in Docker - https://airflow.apache.org/docs/apache-airflow/stable/howto/docker-compose/index.html
AIRFLOW_UID=
POSTGRES_UID=
REDIS_UID=

# Addresses
AIRFLOW_VAR_MINIO_ADDRESS=host.docker.internal:9000
DOCKER_PROXY=tcp://docker-proxy:2375

# Buckets
DEFUALT_OUTPUT_BUCKET=airflow-runs
DOCKER_IMAGES_BUCKET=docker-images

# Modules location - e.g. gis-python scripts repository
MODULES_DIR=

# Don't set S3/MinIO creds here - create a new Connection in GUI using Airflow admin account (Conn Type: aws)
# MINIO_KEY=
# MINIO_SECRET_KEY=
MINIO_HOST=https://host.docker.internal:9000

# Airflow Conn Id names
POSTGRES_AIRFLOW_CONN_ID=metadata
MINIO_AIRFLOW_CONN_ID=minio

# Data in/out locations from within model containers
MATSIM_CONTAINER_INPUT=/opt/matsim/data/input
MATSIM_CONTAINER_OUTPUT=/opt/matsim/data/output
UDM_CONTAINER_INPUT_OUTPUT=/data/inputs #/openudm/Data
UDMSETUP_CONTAINER_INPUT=/data/input
UDMSETUP_CONTAINER_OUTPUT=/data/outputs

# Data in/out locations from within Airflow container
AIRFLOW_BASE=/opt/airflow/cache/
AIRFLOW_MATSIM_INPUT=/opt/airflow/cache/matsim/input/
AIRFLOW_MATSIM_OUTPUT=/opt/airflow/cache/matsim/output/
AIRFLOW_FLOODEVENT_INPUT=/opt/airflow/cache/floodEvent/input/
AIRFLOW_FLOODEVENT_OUTPUT=/opt/airflow/cache/floodEvent/output/
AIRFLOW_UDM_INPUT_OUTPUT=/opt/airflow/cache/udm/input_output/
AIRFLOW_UDMSETUP_INPUT=/opt/airflow/cache/udmSetup/input/
AIRFLOW_UDMSETUP_OUTPUT=/opt/airflow/cache/udmSetup/output/

AIRFLOW_IMAGES_INPUT=/opt/airflow/cache/images/

# Data in/out locations to be mounted to Airflow and model container in/out locations
HOST_BASE=/.../DAReflow/cache/
HOST_MATSIM_INPUT=/.../DAReflow/cache/matsim/input/
HOST_MATSIM_OUTPUT=/.../DAReflow/cache/matsim/output/
HOST_UDM_INPUT_OUTPUT=/.../DAReflow/cache/udm/input_output/
HOST_UDMSETUP_INPUT=/.../DAReflow/cache/udmSetup/input/
HOST_UDMSETUP_OUTPUT=/.../DAReflow/cache/udmSetup/output/

# Defult model params specifying example input data location (MinIO). Strings encased in <> are populated dynamically.
MATSIM_DATAPATH_CONFIG_DEFAULT=airflow-inputs/MATSim/config/example.xml
MATSIM_DATAPATH_NETWORK_DEFAULT=airflow-inputs/MATSim/network/example.xml
MATSIM_DATAPATH_PLANS_DEFAULT=airflow-inputs/MATSim/plans/example.xml
MATSIM_DATAPATH_TRANSITSCHEDULE_DEFAULT=airflow-inputs/MATSim/transit_schedule/example.xml
MATSIM_DATAPATH_TRANSITVEHICLES_DEFAULT=airflow-inputs/MATSim/transit_vehicles/example.xml
MATSIM_DATAPATH_MOTORVEHCOUNTS_DEFAULT=airflow-inputs/MATSim/vehicle_counts/motor/example.xml
MATSIM_DATAPATH_CYCLEPEDALVEHCOUNTS_DEFAULT=airflow-inputs/MATSim/vehicle_counts/pedal_cycle/example.xml
MATSIM_DATAPATH_NETWORKCHANGEEVENTS_DEFAULT=airflow-inputs/MATSim/network_change_events/example.xml

FLOODEVENT_DATAPATH_CONFIG_DEFAULT=airflow-inputs/floodEvent/config/example.json
FLOODEVENT_DATADIR_FLOODRASTERS_DEFAULT=airflow-inputs/floodEvent/rasters/example/
FLOODEVENT_DATAPATH_NETWORK_DEFAULT=airflow-inputs/floodEvent/network/example.gpkg

MATSIM_DATAPATH_NETWORKCHANGEEVENTS_FLOODEVENT=airflow-runs/floodEvent/<scenario>/<start_date>/networkChangeEvents.xml

OPENUDM_DATAPATH_POPULATION_UDMSETUP=airflow-runs/udmsetup/<scenario>/<start_date>/population.csv
OPENUDM_DATAPATH_ZONEIDENTITY_UDMSETUP=airflow-runs/udmsetup/<scenario>/<start_date>/zone_identity.asc
OPENUDM_DATAPATH_ATTRACTORS_UDMSETUP=airflow-runs/udmsetup/<scenario>/<start_date>/attractors.csv
OPENUDM_DATAPATH_CONSTRAINTS_UDMSETUP=airflow-runs/udmsetup/<scenario>/<start_date>/constraints.csv
OPENUDM_DATAPATH_PARAMETERS_UDMSETUP=airflow-runs/udmsetup/<scenario>/<start_date>/parameters.csv
OPENUDM_DATAPATH_METADATA_UDMSETUP=airflow-runs/udmsetup/<scenario>/<start_date>/metadata.csv